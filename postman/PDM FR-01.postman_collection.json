{
  "info": {
    "_postman_id": "bd8b1fb9-8b2a-4e13-bfd5-3fcdad028368",
    "name": "PDM FR-01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Generated from the FR-01 YAML requests in postman/collections/PDM A2 API Testing. Use only an isolated DEV/TEST database. FR-01 requires an empty database; run FR-01 before FR-02 when running both. Preserve request order. Regenerate this JSON after changing its YAML source."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Setup Admin - Invalid Fields",
      "request": {
        "url": "{{base_url}}/api/admin/setup",
        "method": "POST",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "type": "text",
              "value": "admi"
            },
            {
              "key": "password",
              "type": "text",
              "value": "Abcdefg1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Expected setup error is returned', function () {",
              "    pm.expect(pm.response.json().error).to.eql(\"Username must be 5 to 10 characters. Only letters, numbers and underscore are allowed.\");",
              "});",
              "",
              "pm.sendRequest({",
              "    url: pm.variables.replaceIn('{{base_url}}/api/admin/setup-status'),",
              "    method: 'GET'",
              "}, function (error, result) {",
              "    pm.test('Setup status request succeeds', function () {",
              "        pm.expect(error).to.eql(null);",
              "        pm.expect(result.code).to.eql(200);",
              "    });",
              "    if (!error && result) {",
              "        pm.test('Setup initialized is false', function () {",
              "            pm.expect(result.json().initialized).to.eql(false);",
              "        });",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
