        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Development/test database only. Run Prepare Administrator first.",
              "// The preparation requests initialize/verify the administrator and ordinary test user.",
              "pm.variables.set('fr02_admin_username', pm.environment.get('admin_username') || 'admin001');",
              "pm.variables.set('fr02_admin_password', pm.environment.get('admin_password') || 'Abcdefg1');",
              "pm.variables.set('fr02_user_username', 'fr02user');",
              "pm.variables.set('fr02_user_password', 'Abcdefg1');",
              "pm.environment.unset('admin_token');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Operation succeeds', function () {",
              "    pm.expect(pm.response.json().ok).to.eql(true);",
              "});",
              "pm.test('Expected account logged in', function () {",
              "    pm.expect(pm.response.json().username).to.eql(pm.variables.get('fr02_admin_username'));",
              "});",
              "pm.test('Session cookie is returned', function () {",
              "    pm.expect(pm.response.headers.get('Set-Cookie') || '').to.match(/token=[a-f0-9]{32}/);",
              "});",
              "if (pm.response.code === 200) {",
              "    var match = (pm.response.headers.get('Set-Cookie') || '').match(/token=([a-f0-9]{32})/);",
              "    if (match) pm.environment.set('admin_token', match[1]);",
              "}",
              "pm.sendRequest({",
              "    url: pm.variables.replaceIn('{{base_url}}/api/admin/me'),",
              "    method: 'GET',",
              "    header: {Cookie: 'token=' + pm.environment.get('admin_token')}",
              "}, function (error, result) {",
              "    pm.test('Administrator can access the protected API', function () {",
              "        pm.expect(error).to.eql(null);",
              "        pm.expect(result.code).to.eql(200);",
              "        pm.expect(result.json().role).to.eql('admin');",
              "        pm.expect(result.json().username).to.eql(pm.variables.get('fr02_admin_username'));",
              "    });",
              "});"
            ]
          }
        }
      ]
