  "item": [
    {
      "name": "Prepare Administrator",
      "request": {
        "url": "{{base_url}}/api/admin/setup-status",
        "method": "GET"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Development/test database only. Existing administrator credentials are never reset.",
              "pm.variables.set('fr02_admin_username', pm.environment.get('admin_username') || 'admin001');",
              "pm.variables.set('fr02_admin_password', pm.environment.get('admin_password') || 'Abcdefg1');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Setup status is available', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(typeof pm.response.json().initialized).to.eql('boolean');",
              "});",
              "",
              "function verifyAdministrator() {",
              "    pm.sendRequest({",
              "        url: pm.variables.replaceIn('{{base_url}}/api/admin/login'),",
              "        method: 'POST',",
              "        header: {'Content-Type': 'application/json'},",
              "        body: {",
              "            mode: 'raw',",
              "            raw: JSON.stringify({",
              "                username: pm.variables.get('fr02_admin_username'),",
              "                password: pm.variables.get('fr02_admin_password')",
              "            })",
              "        }",
              "    }, function (error, result) {",
              "        pm.test('Prepared administrator accepts the configured credentials', function () {",
              "            pm.expect(error).to.eql(null);",
              "            pm.expect(result.code).to.eql(200);",
              "            pm.expect(result.json().ok).to.eql(true);",
              "            pm.expect(result.json().username).to.eql(pm.variables.get('fr02_admin_username'));",
              "        });",
              "        if (error || !result || result.code !== 200) return;",
              "        var match = (result.headers.get('Set-Cookie') || '').match(/token=([a-f0-9]{32})/);",
              "        pm.test('Administrator preparation returns a session', function () {",
              "            pm.expect(Boolean(match)).to.eql(true);",
              "        });",
              "        if (!match) return;",
              "        pm.sendRequest({",
              "            url: pm.variables.replaceIn('{{base_url}}/api/logout'),",
              "            method: 'POST',",
              "            header: {Cookie: 'token=' + match[1]}",
              "        }, function (logoutError, logoutResult) {",
              "            pm.test('Administrator preparation session is cleared', function () {",
              "                pm.expect(logoutError).to.eql(null);",
              "                pm.expect(logoutResult.code).to.eql(200);",
              "                pm.expect(logoutResult.json().ok).to.eql(true);",
              "            });",
              "        });",
              "    });",
              "}",
              "",
              "if (pm.response.code === 200) {",
              "    var initialized = pm.response.json().initialized;",
              "    if (initialized === true) {",
              "        verifyAdministrator();",
              "    } else if (initialized === false) {",
              "        pm.sendRequest({",
              "            url: pm.variables.replaceIn('{{base_url}}/api/admin/setup'),",
              "            method: 'POST',",
              "            header: {'Content-Type': 'application/json'},",
              "        body: {",
              "            mode: 'raw',",
              "            raw: JSON.stringify({",
              "                username: pm.variables.get('fr02_admin_username'),",
              "                password: pm.variables.get('fr02_admin_password')",
              "            })",
              "        }",
              "        }, function (error, result) {",
              "            pm.test('Missing administrator is initialized', function () {",
              "                pm.expect(error).to.eql(null);",
              "                pm.expect(result.code).to.eql(200);",
              "                pm.expect(result.json().ok).to.eql(true);",
              "            });",
              "            if (!error && result && result.code === 200) verifyAdministrator();",
              "        });",
              "    }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Prepare Test User",
      "request": {
        "url": "{{base_url}}/api/register",
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{fr02_user_username}}\",\n  \"password\": \"{{fr02_user_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Development/test database only; run Prepare Administrator first.",
              "// This dedicated account is kept for subsequent runs.",
              "pm.variables.set('fr02_user_username', 'fr02user');",
              "pm.variables.set('fr02_user_password', 'Abcdefg1');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Test user is created or already exists', function () {",
              "    pm.expect([200, 409]).to.include(pm.response.code);",
              "    if (pm.response.code === 200) {",
              "        pm.expect(pm.response.json().ok).to.eql(true);",
              "    } else {",
              "        pm.expect(pm.response.json().error).to.eql('Username already exists.');",
              "    }",
              "});",
              "",
              "// A duplicate response alone does not prove the account is usable.",
              "if (pm.response.code === 200 || pm.response.code === 409) {",
              "    pm.sendRequest({",
              "        url: pm.variables.replaceIn('{{base_url}}/api/login'),",
              "        method: 'POST',",
              "        header: {'Content-Type': 'application/json'},",
              "        body: {",
              "            mode: 'raw',",
              "            raw: JSON.stringify({",
              "                username: pm.variables.get('fr02_user_username'),",
              "                password: pm.variables.get('fr02_user_password')",
              "            })",
              "        }",
              "    }, function (error, result) {",
              "        pm.test('Prepared user is enabled and has the expected password', function () {",
              "            pm.expect(error).to.eql(null);",
              "            pm.expect(result.code).to.eql(200);",
              "            pm.expect(result.json().username).to.eql(pm.variables.get('fr02_user_username'));",
              "        });",
              "        if (error || !result || result.code !== 200) return;",
              "        var match = (result.headers.get('Set-Cookie') || '').match(/token=([a-f0-9]{32})/);",
              "        pm.test('Preparation login returns a session', function () {",
              "            pm.expect(Boolean(match)).to.eql(true);",
              "        });",
              "        if (!match) return;",
              "        pm.sendRequest({",
              "            url: pm.variables.replaceIn('{{base_url}}/api/logout'),",
              "            method: 'POST',",
              "            header: {Cookie: 'token=' + match[1]}",
              "        }, function (logoutError, logoutResult) {",
              "            pm.test('Preparation session is cleared', function () {",
              "                pm.expect(logoutError).to.eql(null);",
              "                pm.expect(logoutResult.code).to.eql(200);",
              "                pm.expect(logoutResult.json().ok).to.eql(true);",
              "            });",
              "        });",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Login - Valid",
      "request": {
        "url": "{{base_url}}/api/admin/login",
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{fr02_admin_username}}\",\n  \"password\": \"{{fr02_admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
