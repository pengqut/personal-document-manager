{
  "info": {
    "_postman_id": "1f81a707-8374-41db-81c1-afecc1fa0b2d",
    "name": "PDM FR-03",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "FR-03 Normal User List. Run after FR-02 has created the configured normal user. GET requests have no body. The successful list request saves user_id for later requirements."
  },
  "item": [
    {
      "name": "Admin Login - Prepare",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/admin/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var response = pm.response.json();",
              "pm.test('Admin login status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Admin login succeeds', function () { pm.expect(response.ok).to.eql(true); });",
              "var cookie = pm.response.headers.get('Set-Cookie') || '';",
              "var match = cookie.match(/token=([^;]+)/);",
              "pm.test('Admin session cookie is returned', function () { pm.expect(Boolean(match)).to.eql(true); });",
              "if (match) pm.environment.set('admin_token', match[1]);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "List Normal Users - Success",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{admin_token}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/admin/users"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var response = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Users array is returned', function () { pm.expect(response.users).to.be.an('array'); });",
              "var username = pm.environment.get('user_username');",
              "var user = response.users.find(function (item) { return item.username === username; });",
              "pm.test('Configured normal user is listed', function () { pm.expect(user).to.be.an('object'); });",
              "if (user) pm.environment.set('user_id', String(user.id));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "User Login - Prepare Permission Test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{user_username}}\",\n  \"password\": \"{{user_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var response = pm.response.json();",
              "pm.test('User login status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('User login succeeds', function () { pm.expect(response.ok).to.eql(true); });",
              "var cookie = pm.response.headers.get('Set-Cookie') || '';",
              "var match = cookie.match(/token=([^;]+)/);",
              "pm.test('User session cookie is returned', function () { pm.expect(Boolean(match)).to.eql(true); });",
              "if (match) pm.environment.set('user_token', match[1]);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "List Normal Users - Normal User Forbidden",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{user_token}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/admin/users"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var response = pm.response.json();",
              "pm.test('Status code is 403', function () { pm.response.to.have.status(403); });",
              "pm.test('Normal user cannot access admin user list', function () {",
              "    pm.expect(response.error).to.eql('Administrator rights are required.');",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "List Normal Users - Unauthenticated",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "token=invalid-session-token",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/admin/users"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var response = pm.response.json();",
              "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Unauthenticated access is rejected', function () {",
              "    pm.expect(response.error).to.eql('Not logged in.');",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    }
  ]
}