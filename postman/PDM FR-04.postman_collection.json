{
  "info": {
    "_postman_id": "e61b39ba-b2ba-4fd5-bd37-b9bbf1da1195",
    "name": "PDM FR-04",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "FR-04 Enable/Disable Normal Users. All data POST bodies use raw JSON. Disabling invalidates existing sessions; re-enabling permits a new login."
  },
  "item": [
    {
      "name": "Admin Login - Prepare",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/admin/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var response = pm.response.json();",
              "pm.test('Admin login status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Admin login succeeds', function () { pm.expect(response.ok).to.eql(true); });",
              "var cookie = pm.response.headers.get('Set-Cookie') || '';",
              "var match = cookie.match(/token=([^;]+)/);",
              "pm.test('Admin session cookie is returned', function () { pm.expect(Boolean(match)).to.eql(true); });",
              "if (match) pm.environment.set('admin_token', match[1]);"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Find Normal User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{admin_token}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/admin/users"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var response = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Users array is returned', function () { pm.expect(response.users).to.be.an('array'); });",
              "var username = pm.environment.get('user_username');",
              "var user = response.users.find(function (item) { return item.username === username; });",
              "pm.test('Configured normal user is listed', function () { pm.expect(user).to.be.an('object'); });",
              "if (user) pm.environment.set('user_id', String(user.id));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
