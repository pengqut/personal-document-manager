{
  "info": {
    "name": "PDM FR-05 FR-06",
    "description": "Postman tests for SCRUM-45 (FR-05) and SCRUM-49 (FR-06). Run against the local app.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "FR-05 - Individual File Quota",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin001\",\n  \"password\": \"Abcdefg1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/admin/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login status is 200', function () { pm.response.to.have.status(200); });",
                  "var cookie = pm.response.headers.get('Set-Cookie') || '';",
                  "pm.environment.set('admin_token', cookie.split(';')[0].replace('token=', ''));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Find normal user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/admin/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User list status is 200', function () { pm.response.to.have.status(200); });",
                  "var users = pm.response.json().users;",
                  "var user = users.find(function (item) { return item.username === 'alice123'; });",
                  "pm.expect(user, 'alice123 exists').to.be.an('object');",
                  "pm.environment.set('user_id', String(user.id));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Set Quota - Valid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
