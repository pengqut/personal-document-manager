                "key": "Cookie",
                "value": "token={{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_quota\": \"5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/admin/users/{{user_id}}/quota"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var response = pm.response.json();",
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Quota is updated', function () {",
                  "    pm.expect(response.ok).to.eql(true);",
                  "    pm.expect(response.file_quota).to.eql(5);",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
